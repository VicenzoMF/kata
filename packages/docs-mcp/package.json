{
  "name": "@katajs-framework/docs-mcp",
  "version": "0.1.0",
  "description": "Local MCP server exposing lexical search over Kata's documentation (ADR-0022, ADR-0023).",
  "license": "Apache-2.0",
  "author": "Vicenzo Frusciante",
  "homepage": "https://github.com/VicenzoMF/kata#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VicenzoMF/kata.git",
    "directory": "packages/docs-mcp"
  },
  "bugs": {
    "url": "https://github.com/VicenzoMF/kata/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "kata-docs-mcp": "./dist/main.js"
  },
  "files": [
    "dist",
    "data",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "copy-docs": "node scripts/copy-docs.mjs",
    "build": "pnpm run copy-docs && tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "pnpm run copy-docs && tsx src/main.ts",
    "smoke-check": "node scripts/smoke-check.mjs",
    "prepublishOnly": "pnpm run build && pnpm run typecheck"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "minisearch": "^7.2.0",
    "zod": "^3"
  },
  "devDependencies": {
    "@types/node": "^20",
    "tsup": "^8",
    "tsx": "^4.19",
    "typescript": "^5.6"
  }
}
